name: Refresh scores

on:
  schedule:
    # Fridays 6pm–midnight ET during football season (approx)
    - cron: "*/30 22-23 * * 5"   # Fri 6–7:59pm ET (UTC-4)
    - cron: "*/30 0-4 * * 6"     # Fri 8pm–12:59am ET
  workflow_dispatch:

permissions:
  contents: write

jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Attempt score refresh
        id: scrape
        continue-on-error: true
        run: |
          python scripts/refresh_scores.py || echo "Scrape failed or partial — keeping existing scores.json"

      - name: Commit updated scores if changed
        run: |
          if git diff --quiet -- public/scores.json; then
            echo "No score changes."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add public/scores.json
          git commit -m "chore: refresh scores.json ($(date -u +%Y-%m-%dT%H:%MZ))"
          git push
